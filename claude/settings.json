{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "theme": "dark",
  "editorMode": "normal",
  "verbose": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "autoContinueAtUsageLimit": true,
  "promptCacheTtl": "1h",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/agent-resources/plugins/idle-compact",
    "CLAUDE_CODE_PLUGIN_DIR_WATCH": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1"
  }
}
